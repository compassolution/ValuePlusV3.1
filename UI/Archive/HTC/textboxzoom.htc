<script language=jscript>
    var savetop;
    var saveleft;
    var objWidth;
    var objHeight;
    var objTop;
    var objLeft;
    var objBackColor;
    var aElement;
    var isCurMaxSize;
    if (element.tagName == 'TEXTAREA') {
//        element.attachEvent('onclick', click);
        element.attachEvent('ondblclick', dblclick);
        element.attachEvent('onmouseout', mouseout);
        element.attachEvent('onmouseover', mouseover);
    }
    else {
        alert("Error: textboxzoom not attached to a textarea element");
    }
    function mouseover() {
        srcElem = window.event.srcElement;
        if (srcElem.tagName == 'TEXTAREA') {
            savetop = srcElem.style.top;
            saveleft = srcElem.style.left;
            objWidth = srcElem.style.width;
            objHeight = srcElem.style.height;
            objTop = getAbsoluteTop(srcElem);
            objLeft = getAbsoluteLeft(srcElem);
            objBackColor = srcElem.style.backgroundColor;
            //		srcElem.title = "You Can Double Click";
            //        srcElem.style.backgroundColor="#DBDBDB";
            srcElem.style.cursor = "hand";
            //		if(srcElem.Widelines=="true")
            //			srcElem.style.width=500;
            //		else
            //			srcElem.style.width=155;
            //		srcElem.style.height=50;

            //        doZoom(objWidth,60);
        }

    }
    function mouseout() {
        srcElem = window.event.srcElement;
        if (srcElem.tagName == 'TEXTAREA') {
            srcElem.style.zIndex = "";
            //		srcElem.style.width=155;
            //		srcElem.style.height=22;
            srcElem.style.width = objWidth;
            srcElem.style.height = objHeight;
            srcElem.style.backgroundColor = objBackColor;
            srcElem.style.position = "relative";
            if (savetop) {
                srcElem.style.top = savetop;
                srcElem.style.left = saveleft;
            }
            else {
                srcElem.style.top = 0;
                srcElem.style.left = 0;
            }
            srcElem.title = "";
            isCurMaxSize = false;
            //		if(aElement!=null)
            //		{
            //			aElement.style.display = "none";
            //		}
        }
    }
    function dblclick() {
        var screenWidth = window.document.body.clientWidth; //获取窗体宽度
        var screenHeight = window.document.body.clientHeight; //获取窗体高度
        isCurMaxSize = true;
        doZoom(screenWidth, screenHeight);

    }
    function click() {
        if (!isCurMaxSize) {
            doZoom(600, 200);
        }

    }

    function doZoom(setWidth, setHeight) {
        srcElem = window.event.srcElement;
        var curX = event.clientX; //获取鼠标x坐标
        var curY = event.clientY; //获取鼠标y坐标
        var bodyWidth = window.document.body.scrollWidth; //获取窗体宽度
        var bodyHeight = window.document.body.scrollHeight; //获取窗体高度
        var setTop = objTop;
        var setLeft = objLeft;
        srcElem.style.zIndex = 10;
        srcElem.style.width = setWidth;
        srcElem.style.height = setHeight;
        if ((objTop + setHeight) > bodyHeight) {
            setTop = bodyHeight - setHeight;
        }
        if ((objLeft + setWidth) > bodyWidth) {
            setLeft = bodyWidth - setWidth;
        }

        //	srcElem.style.width=eval(window.document.body.clientWidth)-200;
        //    srcElem.style.height=eval(window.document.body.clientHeight)-150;
        srcElem.style.top = setTop;
        srcElem.style.left = setLeft;
        srcElem.style.backgroundColor = "#FFFFFF";
        srcElem.style.position = "absolute";
        srcElem.title = "";


        //	if(aElement==null)
        //	{
        //	aElement=srcElem.document.createElement('<IFRAME id="frTest" style="width:'+eval(window.document.body.clientWidth)
        //	                                        +'px;height:'+eval(window.document.body.clientHeight)
        //	                                        +'px;position:absolute;top:0;left:0;display:inline;" frameborder=0 scrolling=no marginwidth=0 src="" marginheight=0></iframe>');
        //	srcElem.document.body.appendChild(aElement);
        //	}
        //	aElement.style.display = "inline"; 


    }

    //获取控件左绝对位置

    function getAbsoluteLeft(o) {
        //    o = document.getElementById(objectId)
        oLeft = o.offsetLeft
        while (o.offsetParent != null) {
            oParent = o.offsetParent
            oLeft += oParent.offsetLeft
            o = oParent
        }
        return oLeft
    }
    //获取控件上绝对位置
    function getAbsoluteTop(o) {
        //    o = document.getElementById(objectId);
        oTop = o.offsetTop;
        while (o.offsetParent != null) {
            oParent = o.offsetParent
            oTop += oParent.offsetTop  // Add parent top position
            o = oParent
        }
        return oTop
    }



</script>