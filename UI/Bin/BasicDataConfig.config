  <!--*******************************Add by wangsm Begin-->
  
  <!--**执行排班结果考勤的存储过程名称及参数-->
	<SpName_AnalysePaiBanReuslt>SP_AnlysePaiBanResult</SpName_AnalysePaiBanReuslt>
	<SpParam1_AnalysePaiBanReuslt>SUSERID</SpParam1_AnalysePaiBanReuslt>
  <SpParam2_AnalysePaiBanReuslt>YEARMONTH</SpParam2_AnalysePaiBanReuslt>
	<!--**排班班次过滤视图及其字段名-->
	<VwName_PaibanShift_Filter>VW_PAIBAN_SHIFT_FILTER</VwName_PaibanShift_Filter>
	<VwCol1_PaibanShift_Filter>SUSERID</VwCol1_PaibanShift_Filter>
	<VwCol2_PaibanShift_Filter>SHIFTCODE</VwCol2_PaibanShift_Filter>
	<!--**可进行排班的员工过滤视图及其字段名-->
	<VwName_PaibanStaff_Filter>VW_PAIBAN_STAFF_FILTER</VwName_PaibanStaff_Filter>
	<VwCol1_PaibanStaff_Filter>SUSERID</VwCol1_PaibanStaff_Filter>
	<VwCol2_PaibanStaff_Filter>STAFFID</VwCol2_PaibanStaff_Filter>

	<!--**员工异常考勤结果过滤视图及其字段名-->
	<VwName_UnNormalKQ_Filter>VW_HR_KQ_UNNORMAL</VwName_UnNormalKQ_Filter>
	<VwCol1_UnNormalKQ_Filter>SSTAFFNO</VwCol1_UnNormalKQ_Filter>
	<VwCol2_UnNormalKQ_Filter>SYEARMONTH</VwCol2_UnNormalKQ_Filter>
	<VwCol3_UnNormalKQ_Filter>SDAY</VwCol3_UnNormalKQ_Filter>
	<VwCol4_UnNormalKQ_Filter>SSTATE</VwCol4_UnNormalKQ_Filter>
 
	<!--**查询视图的唯一键值的字段名-->
	<KeyName_QueryView>SVIEWKEY</KeyName_QueryView>

  <!--**标识加班调休的类型编码-->
  <ot_type>1</ot_type>
  <lv_type>LV080</lv_type>
  <!--**执行加班调休对冲核销的存储过程名称及参数-->
  <SpName_OTRestVerify>SP_OTRestVerify</SpName_OTRestVerify>
  <SpParam1_OTRestVerify>STUFFID</SpParam1_OTRestVerify>
  <SpParam2_OTRestVerify>DTDATE</SpParam2_OTRestVerify>
  
  <!--**系统基本参数配置模板-->
  <TID_BasicParam>BASICPARAM</TID_BasicParam>
  <!--**工作流相关参数配置模板-->
  <TID_FlowConfigParam>FLOWCONFIGPARAM</TID_FlowConfigParam>
  <!--**档案模板样式配置模板-->
  <TID_ArchiveStyleParam>ARCHIVESTYLEPARAM</TID_ArchiveStyleParam>
  <!--**上传下载功能配置模板-->
  <TID_UpdownConfigParam>UPDOWNCONFIGPARAM</TID_UpdownConfigParam>

  <!--**系统报表相关文件存放路径-->
  <PATH_ReortFile>../SysFile/Report</PATH_ReortFile>
  <!--**存储查询中存储过程xml配置文件存放路径-->
  <PATH_SPXmlFile>../SysFile/SP/xml</PATH_SPXmlFile>
  <!--**档案模板存储过程类型动作的存储过程xml配置文件存放路径-->
  <PATH_ActionXmlFile>../../SysFile/Action/xml</PATH_ActionXmlFile>
  <!--**用户操作档案模板页面上传文件的存放路径-->
  <PATH_ArchiveAttFile>../../UserFile/ArchiveAtt</PATH_ArchiveAttFile>

  <!--**存储过程执行报错前等待时间-->
  <iCommandTimeoutForSP>1200</iCommandTimeoutForSP>
  <!--**排班后即时进行考勤分析的存储过程名称及参数-->
  <SpName_RealTimeAnalysePaiBanReuslt>USP_RealTimeAnlysePaiBanResult</SpName_RealTimeAnalysePaiBanReuslt>
  <SpParam1_RealTimeAnalysePaiBanReuslt>STAFFID</SpParam1_RealTimeAnalysePaiBanReuslt><!--员工编号.-->
  <SpParam2_RealTimeAnalysePaiBanReuslt>YEARMONTH</SpParam2_RealTimeAnalysePaiBanReuslt><!--月份1206-->
  <SpParam3_RealTimeAnalysePaiBanReuslt>DAYS</SpParam3_RealTimeAnalysePaiBanReuslt><!--日期D1/D2/D3.....-->

  <!--资产系统中，判断如果当前系统时间不处于当前月份，则针对部门模板进行提示-->
  <Monthly_Notice_TID>AMASSETS;AMF001;AMF002;AMF003;AMF004;AMF005;AMF010;AMF020;AMPLAN;OEITEM;OERCP;OETRS;OEADJ;OESHP;OEPHY;</Monthly_Notice_TID>

</BaseConfigInfo>