<?xml version="1.0" encoding="utf-8" ?>
<CommonSqlConfigInfo>
  <!--*******************************Add by wangsm Start-->
  <!--**员工薪资变更调整处理页面相关sql语句-->
  <strSql_GetStaffPayItem>select * from pritem_1 where bisstop = '2'</strSql_GetStaffPayItem>
  <strSql_GetStaffList_Col>select TOP 1 A.YEARMONTHDCNO,A.YEARMONTH, A.EMPNO,A.EMPNAME,A.EMPNAMECHS,B.DCDDESCCHS,C.ODESC,C.ODESCCHS from PREMPL_1 A inner join HRDOCU_1 B ON A.EMPNO = B.DCNO inner join CSORGA_1 C ON B.DCDDESCCHS = C.OID where A.ISHOLD = '2' AND A.ISPAYED = '2'</strSql_GetStaffList_Col>
  <strSql_GetStaffList_Count>select count(A.EMPNO) from PREMPL_1 A inner join HRDOCU_1 B ON A.EMPNO = B.DCNO where A.ISHOLD = '2' AND A.ISPAYED = '2'</strSql_GetStaffList_Count>
  <strSql_GetStaffList>select A.YEARMONTHDCNO,A.YEARMONTH,A.EMPNO,A.EMPNAME,A.EMPNAMECHS,B.DCDDESCCHS,C.ODESC,C.ODESCCHS from PREMPL_1 A inner join HRDOCU_1 B ON A.EMPNO = B.DCNO inner join CSORGA_1 C ON B.DCDDESCCHS = C.OID where A.ISHOLD = '2' AND A.ISPAYED = '2'</strSql_GetStaffList>
  <strSql_GetStaffList_MultiPage>select top (@PAGESIZE) A.YEARMONTHDCNO,A.YEARMONTH,A.EMPNO,A.EMPNAME,A.EMPNAMECHS,B.DCDDESCCHS,C.ODESC,C.ODESCCHS from PREMPL_1 A inner join HRDOCU_1 B ON A.EMPNO = B.DCNO inner join CSORGA_1 C ON B.DCDDESCCHS = C.OID where A.ISHOLD = '2' AND A.ISPAYED = '2' AND A.YEARMONTHDCNO not in (select top (@STARTINDEX) A.YEARMONTHDCNO from PREMPL_1 A WHERE A.ISHOLD = '2' AND A.ISPAYED = '2') order by A.EMPNO</strSql_GetStaffList_MultiPage>
  <strSql_GetStaffPayValue_Col>select top 1 A.YEARMONTHDCNO,A.YEARMONTH,a.EMPNO,EMPNAME,EMPNAMECHS,b.ITEMCODE,c.ITEMNAME,c.ITEMNAMECHS,b.ITEMEVALUE,b.ITEMCOMM from prempl_1 a inner join prempl_2 b on a.yearmonthdcno=b.yearmonthdcno inner join pritem_1 c on b.itemcode=c.itemcode where c.itemedit=2 </strSql_GetStaffPayValue_Col>
  <strSql_GetStaffPayValue>select A.YEARMONTHDCNO,A.YEARMONTH,a.EMPNO,EMPNAME,EMPNAMECHS,b.ITEMCODE,c.ITEMNAME,c.ITEMNAMECHS,b.ITEMEVALUE,b.ITEMCOMM from prempl_1 a inner join prempl_2 b on a.yearmonthdcno=b.yearmonthdcno inner join pritem_1 c on b.itemcode=c.itemcode where c.bisstop = '2' and a.yearmonthdcno=@yearmonthdcno order by c.ITEMCORDER </strSql_GetStaffPayValue>
  <strSql_UpdateStaffPayValue>update prempl_2 set ITEMEVALUE=@ITEMEVALUE, ITEMCOMM=@ITEMCOMM from prempl_2 where yearmonthdcno=@yearmonthdcno and itemcode=@itemcode</strSql_UpdateStaffPayValue>
  <!--**员工薪资变更调整处理页面相关sql语句-->

  <!--**员工薪资条页面相关sql语句-->
  <strSql_PRSLIP_GetStaffPayItem>select * from pritem_1 where bisstop = '2'</strSql_PRSLIP_GetStaffPayItem>
  <strSql_PRSLIP_GetStaffList_Col>select top 1 * from PRSLIP</strSql_PRSLIP_GetStaffList_Col>
  <strSql_PRSLIP_GetStaffList_Count>select count(YEARMONTHDCNO) from PRSLIP</strSql_PRSLIP_GetStaffList_Count>
  <strSql_PRSLIP_GetStaffList>select * from PRSLIP order by YEARMONTHDCNO</strSql_PRSLIP_GetStaffList>
  <strSql_PRSLIP_GetStaffList_MultiPage>select top (@PAGESIZE) * from PRSLIP where YEARMONTHDCNO not in (select top (@STARTINDEX) YEARMONTHDCNO from PRSLIP) order by YEARMONTHDCNO</strSql_PRSLIP_GetStaffList_MultiPage>
  <!--**员工薪资条页面相关sql语句-->

  <!--**根据年月员工计算对应的薪资项目值的存储过程名称（参数1：yearmonthdcno；参数2：usercode）-->
  <SpName_CalPRITEM_ByYearMonthAndDCNO>USP_HR_PREMPL_CalPRITEM_ByDCNO</SpName_CalPRITEM_ByYearMonthAndDCNO>
  
  <!--**根据年月员工更新薪资条表中对应的薪资项目值的存储过程名称（参数1：yearmonthdcno；参数2：usercode）-->
  <SpName_InitPRSLIP_ByYearMonthAndDCNO>USP_HR_PRSLIP_InitDataByYearMonthDcno</SpName_InitPRSLIP_ByYearMonthAndDCNO>

  <!--**查询薪资项目结果信息(&用@代替)-->
  <Page_QueryPREMPL_CalResult>../Query/SPQuery.aspx?SP=USP_HR_QRY_PREMPL_CalResult@P0=NONE</Page_QueryPREMPL_CalResult>

  <!--**员工加班调休调整处理页面相关sql语句-->
  <strSql_OTREST_GetStaffList_Col>select top 1 STAFFID,DCNAME,DCNAMECHS from FUN_VW_PAIBAN_STAFF_FILTER('@YEARMONTH')</strSql_OTREST_GetStaffList_Col>
  <strSql_OTREST_GetStaffList_COUNT>select COUNT(*) from FUN_VW_PAIBAN_STAFF_FILTER('@YEARMONTH') A INNER JOIN FUN_KQTOE_1('@YEARMONTH') B ON A.STAFFID = b.EMPLOYEE  WHERE SUSERID='@SUSERID'</strSql_OTREST_GetStaffList_COUNT>
  <strSql_OTREST_GetStaffList_DATA>select STAFFID,DCNAME,DCNAMECHS from VW_PAIBAN_STAFF_FILTER WHERE SUSERID='@SUSERID'</strSql_OTREST_GetStaffList_DATA>
  <strSql_OTREST_GetStaffList_MultiPage>select top (@PAGESIZE) STAFFID,DCNAME,DCNAMECHS from FUN_VW_PAIBAN_STAFF_FILTER('@YEARMONTH') A INNER JOIN FUN_KQTOE_1('@YEARMONTH') B ON A.STAFFID = b.EMPLOYEE WHERE SUSERID='@SUSERID' AND STAFFID NOT IN (select top (@STARTINDEX) STAFFID from VW_PAIBAN_STAFF_FILTER WHERE SUSERID='@SUSERID') order BY A.DeptCode,A.DCPLEVEL,A.STAFFID</strSql_OTREST_GetStaffList_MultiPage>
  <strSql_OTREST_GetDateList_Col>SELECT top 1 B.em_No,A.DNUM,A.DATE,B.[Shift],B.SJBHOUR,B.STXHOUR,B.BISTONORMAL,B.ExceptionChs,B.SREMARK FROM KQPERD_3 A LEFT JOIN KQRSSZ_2 B ON A.DATE = B.r_Date</strSql_OTREST_GetDateList_Col>
  <strSql_OTREST_GetDateList_DATA>SELECT B.em_No,A.DNUM,A.DATE,B.[Shift],B.SJBHOUR,B.STXHOUR,B.BISTONORMAL,B.ExceptionChs,B.SREMARK FROM KQPERD_3 A LEFT JOIN KQRSSZ_2 B ON A.DATE = B.r_Date where A.PID = '@YEARMONTH' AND B.EM_NO = '@STAFFNO' ORDER BY A.DATE</strSql_OTREST_GetDateList_DATA>
  <!--**员工加班调休调整处理页面相关sql语句-->


  <!--*******************************Add by wangsm End-->
</CommonSqlConfigInfo>