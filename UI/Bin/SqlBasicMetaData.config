  <!---票据获得模板SD-->
  <Template_TB_HRTMPSD_Document>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql><![CDATA[SELECT PID,PDESC,PDESCCHS,PCTRL,PDEFAULT,PCTRLID,PCTRLD,PISKEY,PSYS,PRIGHT,PTYPE,PWIDTH FROM TB_HRTMPSD WHERE PRIGHT<2 AND TID=@TID AND SID=@SID AND GID=@GID AND PLIST='1' AND PTYPE<>'CH' AND PTYPE<>'CS'  ORDER BY PORDER]]></CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@TID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>20</VariableLength>
