  <!---模板系统参数－D-->
  <Template_TB_HRTMPDSys_D>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>      
      <CommandSql>
        if @language='zh-cn'
        SELECT [PID],[PDESCCHS] FROM [TB_HRTMPD] WHERE TID='HRUP' ORDER BY PORDER
        else
        SELECT [PID],[PDESC] FROM [TB_HRTMPD] WHERE TID='HRUP' ORDER BY PORDER
      </CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@language</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>50</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </Template_TB_HRTMPDSys_D>
  <!---模板系统字体颜色－D-->
  <Template_TB_HRTMPDFont_D>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>
        if @language='zh-cn'
        SELECT FID,FDESCCHS AS [FTEXT] FROM TB_HRFONT ORDER BY FID;
        else
        SELECT FID,FDESC AS [FTEXT] FROM TB_HRFONT ORDER BY FID;
      </CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@language</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>50</VariableLength>
        </NameValueParameters>        
      </NameValueParameters>
    </SqlBasicMetaData>
  </Template_TB_HRTMPDFont_D>
