          <VariableLength>20</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </Template_TB_HRTMPSA_Document>
  <!---票据获得模板AR-->
  <Template_TB_HRTMPAR_Document>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>
            <![CDATA[
        if @language='zh-cn'
          SELECT MESSCHS FROM TB_HRTMPAR WHERE TID=@TID AND AID=@AID AND ECFROM<=@ECFROM AND ECTO>=@ECFROM;
          else
          SELECT MESSENG FROM TB_HRTMPAR WHERE TID=@TID AND AID=@AID AND ECFROM<=@ECFROM AND ECTO>=@ECFROM;
          ]]></CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@language</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>20</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@TID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>20</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@AID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>20</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@ECFROM</VariableName>
          <VariableType>int</VariableType>
          <VariableLength>0</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </Template_TB_HRTMPAR_Document>
