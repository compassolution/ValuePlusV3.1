    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT AID,ADETAIL,APARA0,APARA1,APARA2,APARA3,APARA4,APARA5,APARA6,APARA7,APARA8,APARA9 FROM TB_HRTMPSA WHERE TID=@TID AND SID=@SID AND ARIGHT='1' AND ALOCATION='6' ORDER BY AORDER</CommandSql>
