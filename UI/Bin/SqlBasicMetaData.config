<?xml version="1.0" encoding="utf-8" ?>
<SQLConfigInfo>
  <!--写错误日志-->
  <UserErrInsert>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>INSERT INTO TB_HRERR ([USERCODE],[TID],[SID],[RID],[DETALL],[errtime]) VALUES(@USERCODE,@TID,@SID,@RID,@DETAIL,getdate())</CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@USERCODE</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>100</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@TID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>100</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@SID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>100</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@RID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>100</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@DETAIL</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>100</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </UserErrInsert>
  <!--登录验证--> 
  <UserLoginAuth>
    <SqlBasicMetaData>
      <CommandType>procedure</CommandType>
      <CommandSql>p_tb_userlogin</CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@SACCOUNTID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>30</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@PWD</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>16</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@guid</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@ip</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>50</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </UserLoginAuth>
  <!--登录退出-->
  <UserLoginExit>
    <SqlBasicMetaData>
      <CommandType>procedure</CommandType>
      <CommandSql>p_tb_userExit</CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@SUSERID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </UserLoginExit>
  <!--用户树菜单－管理员-->
  <UserTreeAdmin>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT [SMENUCODE],[SMENUNAME],[SMENUNAMECN],[SURLDETAIL],[SMENUTYPE],[SIMAGE],[SPARENTCODE],[SLEVEL],[SORDER],[BISSTOP] FROM [TB_HR_MENU] WHERE [BISSTOP]=0 ORDER BY [SORDER] ASC</CommandSql>      
    </SqlBasicMetaData>
  </UserTreeAdmin>
  <!--用户树菜单－非管理员-->
  <UserTreeNotAdmin>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT rm.[SMENUCODE],rm.[SMENUNAME],rm.[SMENUNAMECN],rm.[SURLDETAIL],rm.[SMENUTYPE],rm.[SIMAGE],rm.[SPARENTCODE],rm.[SLEVEL],rm.[SORDER],rm.[BISSTOP] FROM [TB_HR_MENU] rm,[TB_HR_USERMENU] ru  where rm.[SMENUCODE]=ru.[SMENUCODE] and rm.[BISSTOP]=0 and ru.[SRIGHTS]='1' and ru.[SUSERID]=@SUSERID ORDER BY [SORDER] ASC</CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@SUSERID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
        </NameValueParameters>        
      </NameValueParameters>
    </SqlBasicMetaData>
  </UserTreeNotAdmin>
  <!--通过用户ID获取相应用户信息-->
  <TB_HR_USER.selectByUserId>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT [SUSERID],[SACCOUNTID],[dbo].[Fun_Decode_Password]([SPWD]) as [SPWD],[STAFFNO],[SUSERNAME],[SUSERNAMECN],[SDEPT],[SDEPTCN],[SPOSI],[SPOSICN],[STREECLR],[SWORKCLR],[BISALERT],[BISGROUPUSER],[BISSTOP],[SDEPTCODE] FROM [TB_HR_USER] where [SUSERID]=@SUSERID </CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@SUSERID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </TB_HR_USER.selectByUserId>
