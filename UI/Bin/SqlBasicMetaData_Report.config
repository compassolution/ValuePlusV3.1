<?xml version="1.0" encoding="utf-8" ?>
<!--对数据视图（view）操作相关配置文件-->
<SQLConfigInfo>
  <!--*******************************Add by wangsm Begin-->
  
  <!--根据用户标识对数据视图【VW_HR_UP1】的select操作相关配置文件-->
  <VW_HR_UP1.select.byUserCode>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT * FROM VW_HRUP_1 WHERE USERCODE =@USERCODE</CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@USERCODE</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </VW_HR_UP1.select.byUserCode>

  <!--根据主键查询数据表【TB_HRTMPSD】的select操作相关配置文件-->
  <TB_HRTMPSD.select.byKey>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT PID,PDESC,PDESCCHS,PCTRL,PCTRLID,PCTRLD,PTYPE,PDEFAULT,PSYS,PRIGHT,PMAST FROM TB_HRTMPSD  WHERE TID =@TID AND GID =@GID AND SID =@SID AND PID =@PID</CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@TID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>20</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@GID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>20</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@SID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>20</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@PID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>20</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </TB_HRTMPSD.select.byKey>
  

  <!--*******************************Add by wangsm End-->
</SQLConfigInfo>