  <KQTOE_1A2.select.byYearMonthAndUserId>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>select A.ENAME,A.CNAME,A.EMPDEPT,B.* from KQTOE_1 A,KQTOE_2 B,[VIEWNAME] vwName WHERE A.EMPLOYEE = B.EMPLOYEE and B.YEARMONTH = @YEARMONTH AND A.EMPLOYEE = vwName.[STAFFID] AND vwName.[SUSERID] = @SUSERID ORDER BY A.EMPLOYEE</CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@YEARMONTH</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>8</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
