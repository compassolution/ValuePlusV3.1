  <!--对数据表【TB_HR_MENU】的select操作相关配置文件-->
  <TB_HR_MENU.selectAll>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT SMENUCODE,SMENUNAME,SMENUNAMECN,SURLDETAIL,SMENUTYPE,SIMAGE,SPARENTCODE,SLEVEL,SORDER,BISSTOP,SSHOWLOCATION FROM TB_HR_MENU ORDER BY SORDER</CommandSql>
    </SqlBasicMetaData>
  </TB_HR_MENU.selectAll>
  <TB_HR_MENU.select.byMenuCode>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT SMENUCODE,SMENUNAME,SMENUNAMECN,SURLDETAIL,SMENUTYPE,SIMAGE,SPARENTCODE,SLEVEL,SORDER,BISSTOP,SSHOWLOCATION FROM  TB_HR_MENU WHERE SMENUCODE =@SMENUCODE  ORDER BY SORDER</CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@SMENUCODE</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>20</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </TB_HR_MENU.select.byMenuCode>
  <TB_HR_MENU.selectSubLevel.byMenuCode>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT SMENUCODE,SMENUNAME,SMENUNAMECN,SURLDETAIL,SMENUTYPE,SIMAGE,SPARENTCODE,SLEVEL,SORDER,BISSTOP,SSHOWLOCATION FROM  TB_HR_MENU WHERE SPARENTCODE =@SMENUCODE  ORDER BY SORDER</CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@SMENUCODE</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>20</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </TB_HR_MENU.selectSubLevel.byMenuCode>
	<TB_HR_MENU.selectSubLevel.byMenuCodeAUserId>
		<SqlBasicMetaData>
			<CommandType>text</CommandType>
			<CommandSql>SELECT rm.[SMENUCODE],rm.[SMENUNAME],rm.[SMENUNAMECN],rm.[SURLDETAIL],rm.[SMENUTYPE],rm.[SIMAGE],rm.[SPARENTCODE],rm.[SLEVEL],rm.[SORDER],rm.[BISSTOP],rm.[SSHOWLOCATION],ru.[SUSERID] FROM [TB_HR_MENU] rm,[TB_HR_USERMENU] ru  where rm.[SMENUCODE]=ru.[SMENUCODE] and rm.SPARENTCODE =@SMENUCODE and ru.[SUSERID] =@SUSERID ORDER BY [SORDER] ASC</CommandSql>
			<NameValueParameters>
				<NameValueParameters>
					<VariableName>@SMENUCODE</VariableName>
					<VariableType>varchar</VariableType>
					<VariableLength>20</VariableLength>
				</NameValueParameters>
				<NameValueParameters>
					<VariableName>@SUSERID</VariableName>
					<VariableType>varchar</VariableType>
					<VariableLength>40</VariableLength>
				</NameValueParameters>
			</NameValueParameters>
		</SqlBasicMetaData>
	</TB_HR_MENU.selectSubLevel.byMenuCodeAUserId>
