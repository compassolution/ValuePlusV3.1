  <!--根据当前用户ID对数据表【KQRSSZ_1】和【KQRSSZ_2】的通过员工编号，月份及日期select操作相关配置文件（服务器端分页）-->
  <KQRSSZ_1A2.select.byNoDateAUserId.MultiPage>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT TOP (@PAGESIZE) A.Ymonth,A.DCNAMEC,A.DCNAMEE,B.* FROM KQRSSZ_1 A,KQRSSZ_2 B ,[VIEWNAME] vwName WHERE A.SEQNO = B.SEQNO AND A.YMONTH = @YMONTH  AND A.em_No = vwName.[STAFFID] AND vwName.[SUSERID] = @SUSERID AND B.BISTONORMAL = @BISTONORMAL AND B.SEQNO++CONVERT(VARCHAR(10),B.R_DATE) NOT IN (SELECT TOP (@STARTINDEX) B.SEQNO+CONVERT(VARCHAR(10),B.R_DATE) FROM KQRSSZ_1 A,KQRSSZ_2 B ,[VIEWNAME] vwName WHERE A.SEQNO = B.SEQNO AND A.YMONTH = @YMONTH  AND A.em_No = vwName.[STAFFID] AND vwName.[SUSERID] = @SUSERID AND B.BISTONORMAL =@BISTONORMAL)</CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@YMONTH</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>8</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@SUSERID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@PAGESIZE</VariableName>
          <VariableType>int</VariableType>
          <VariableLength>0</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@STARTINDEX</VariableName>
          <VariableType>int</VariableType>
          <VariableLength>0</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@BISTONORMAL</VariableName>
          <VariableType>CHAR</VariableType>
          <VariableLength>1</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </KQRSSZ_1A2.select.byNoDateAUserId.MultiPage>
    
