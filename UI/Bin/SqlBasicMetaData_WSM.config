        <NameValueParameters>
          <VariableName>@DATEF</VariableName>
          <VariableType>datetime</VariableType>
          <VariableLength>8</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </KQLV_1.select.byStuffId>


