  <KQTOE_1A2.select.byYearMonth>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>select top 20 A.ENAME,A.CNAME,A.EMPDEPT,B.* from KQTOE_1 A,KQTOE_2 B WHERE A.EMPLOYEE = B.EMPLOYEE and B.YEARMONTH = @YEARMONTH ORDER BY A.EMPLOYEE</CommandSql>
