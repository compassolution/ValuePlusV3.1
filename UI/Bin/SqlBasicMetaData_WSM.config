      <CommandSql>
        <![CDATA[select LVNO,EMPLOYEE,LVDATEF,LVDATET,LVTIME,ISNULL(LVSST,2) AS LVSST from KQLV_1 WHERE LVTYPE = '[LVTYPE]' AND EMPLOYEE = @STUFFID AND LVDATEF <=@DATEF ORDER BY LVDATEF]]>
      </CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@STUFFID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
