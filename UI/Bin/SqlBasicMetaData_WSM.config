  <TB_HRTMPR.select.byUserId>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT A.SUSERID,B.TID,B.RID,B.RDESC,B.RDESCCHS,C.TDESC,C.TDESCCHS FROM TB_HR_USERROLE A inner join TB_HRTMPR B on  A.RID = B.RID  AND A.TID = B.TID INNER JOIN TB_HRTMPH AS C ON B.TID=C.TID WHERE A.SUSERID =@SUSERID </CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@SUSERID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </TB_HRTMPR.select.byUserId>
  <!--对数据表【TB_HRTMPR】的select操作相关配置文件-->
  <TB_HRTMPR.select.byCurUserIdAndSelUserId>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>
        SELECT A.SUSERID,B.TID,B.RID,B.RDESC,B.RDESCCHS,C.TDESC,C.TDESCCHS FROM TB_HR_USERROLE A INNER JOIN TB_HRTMPR B ON A.RID = B.RID AND A.TID=B.TID INNER JOIN TB_HRTMPH AS C ON B.TID=C.TID WHERE A.SUSERID =@CurUserId AND (A.RID+A.TID NOT IN (SELECT DISTINCT RID+TID FROM TB_HR_USERROLE WHERE SUSERID = @SelUserId))</CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@CurUserId</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@SelUserId</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </TB_HRTMPR.select.byCurUserIdAndSelUserId>

