  <!--对数据表【KQOVTM_1】的select操作相关配置文件-->
  <KQOVTM_1.select.byStuffId>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>
        <![CDATA[select OTNO,EMPLOYEE,OTDATEF,OTTYPE,OTTIME,ISNULL(OTCTIME,0) AS OTCTIME from KQOVTM_1 WHERE OTPTYPE = '[OTTYPE]' AND ISNULL(OTTIME,0)!=ISNULL(OTCTIME,0) AND EMPLOYEE = @STUFFID AND OTDATEF <=@DATEF  ORDER BY OTDATEF]]>
      </CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@STUFFID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@DATEF</VariableName>
          <VariableType>datetime</VariableType>
          <VariableLength>8</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </KQOVTM_1.select.byStuffId>

