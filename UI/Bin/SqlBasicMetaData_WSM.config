  <!--根据当前用户ID对数据表【KQRSSZ_1】和【KQRSSZ_2】的通过员工编号，月份及日期select操作相关配置文件-->
  <KQRSSZ_1A2.select.byNoDateAUserId>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT A.Ymonth,A.DCNAMEC,A.DCNAMEE,B.* FROM KQRSSZ_1 A,KQRSSZ_2 B ,[VIEWNAME] vwName WHERE A.SEQNO = B.SEQNO AND A.YMONTH = @YMONTH  AND A.em_No = vwName.[STAFFID] AND vwName.[SUSERID] = @SUSERID AND  B.BISTONORMAL =@BISTONORMAL</CommandSql>
