  <TB_FLOW_WORKFLOW_DETAIL.selectLastTrasferByFlowId>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT * FROM TB_FLOW_WORKFLOW_DETAIL WHERE SWORKFLOWCODE =@SWORKFLOWCODE  AND BISCURSTEP = '1'</CommandSql>
