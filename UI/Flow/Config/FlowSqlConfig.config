  <!--对数据表【TB_FLOW_WORK_INSTANCE】和【TB_FLOW_WORKFLOW_DETAIL】的selectPendingByUserId操作相关配置文件（待办事项查询）-->
  <TB_FLOW_WORK_INSTANCE.selectPendingByUserId>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>
        select top (@iPageSize) b.* from TB_FLOW_WORK_INSTANCE a inner join TB_FLOW_WORKFLOW_DETAIL b on a.SWORKFLOWCODE = b.SWORKFLOWCODE where a.SPENDINGUSERID = @SUSERID AND (@CONDITION)
        AND ((B.NNUMBER = 1 and B.BISCURSTEP = '1') or (B.NNUMBER = (SELECT NNUMBER-1 FROM TB_FLOW_WORKFLOW_DETAIL WHERE BISCURSTEP = '1' and SWORKFLOWCODE = A.SWORKFLOWCODE)))
        AND A.SWORKFLOWCODE NOT IN (
        select TOP (@iStartIndex) A.SWORKFLOWCODE from TB_FLOW_WORK_INSTANCE a inner join TB_FLOW_WORKFLOW_DETAIL b on a.SWORKFLOWCODE = b.SWORKFLOWCODE
        where a.SPENDINGUSERID = @SUSERID AND (@CONDITION)
        AND ((B.NNUMBER = 1 and B.BISCURSTEP = '1') or (B.NNUMBER = (SELECT NNUMBER-1 FROM TB_FLOW_WORKFLOW_DETAIL WHERE BISCURSTEP = '1' and SWORKFLOWCODE = A.SWORKFLOWCODE)))
        ORDER BY DTDESTDATE DESC
        )
        ORDER BY DTDESTDATE DESC
      </CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@iPageSize</VariableName>
          <VariableType>int</VariableType>
          <VariableLength>0</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@iStartIndex</VariableName>
          <VariableType>int</VariableType>
          <VariableLength>0</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@SUSERID</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
        </NameValueParameters>
        <NameValueParameters>
          <VariableName>@CONDITION</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>500</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </TB_FLOW_WORK_INSTANCE.selectPendingByUserId>

  <!--根据流程实例编码对数据表【TB_FLOW_WORKFLOW_DETAIL】的selectPreviousTrasferByFlowId操作获取上一条流转信息相关配置文件-->
  <TB_FLOW_WORKFLOW_DETAIL.selectPreviousTrasferByFlowId>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>
        if(SELECT NNUMBER FROM TB_FLOW_WORKFLOW_DETAIL WHERE BISCURSTEP = '1' AND SWORKFLOWCODE=@SWORKFLOWCODE)=1
        select * from TB_FLOW_WORKFLOW_DETAIL where SWORKFLOWCODE = @SWORKFLOWCODE AND BISCURSTEP = '1'
        ELSE
        select * from TB_FLOW_WORKFLOW_DETAIL where SWORKFLOWCODE = @SWORKFLOWCODE AND NNUMBER = (SELECT NNUMBER-1 FROM TB_FLOW_WORKFLOW_DETAIL WHERE BISCURSTEP = '1' and SWORKFLOWCODE = @SWORKFLOWCODE)
      </CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@SWORKFLOWCODE</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
        </NameValueParameters>
      </NameValueParameters>
    </SqlBasicMetaData>
  </TB_FLOW_WORKFLOW_DETAIL.selectPreviousTrasferByFlowId>


  <!--同时对数据表【TB_FLOW_WORK_INSTANCE】和【TB_FLOW_WORKFLOW_DETAIL】的流程转交状态编码操作相关配置文件-->
  <TB_FLOW_WORK_INSTANCE.TB_FLOW_WORKFLOW_DETAIL.updateMoveStateByFlowId>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>
        UPDATE TB_FLOW_WORK_INSTANCE SET SFLOWMOVECODE = @SFLOWMOVECODE where SWORKFLOWCODE = @SWORKFLOWCODE;
        UPDATE TB_FLOW_WORKFLOW_DETAIL SET SFLOWMOVECODE = @SFLOWMOVECODE where SWORKFLOWCODE = @SWORKFLOWCODE and BISCURSTEP = '1'
      </CommandSql>
