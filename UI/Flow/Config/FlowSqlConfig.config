      <CommandSql>SELECT SFLOWACTIONCODE,SPOSTCODE,SFLOWACTIONNAME,SFLOWACTIONNAMECN,SACTIONDETAIL,NINDEX,SBIZSTATUS,SPLUGIN_PRE,SPLUGIN_AFTER FROM TB_FLOW_POST_ACTION WHERE SPOSTCODE =@SPOSTCODE ORDER BY NINDEX</CommandSql>
