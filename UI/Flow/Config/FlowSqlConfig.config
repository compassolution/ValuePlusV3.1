  <!--对数据表【TB_FLOW_PATH】的selectByPrePostCode操作相关配置文件-->
  <TB_FLOW_PATH.selectByPrePostCode>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>select A.SFLOWPATHCODE,A.SPOSTCODE_PRE,A.SPOSTCODE_NEXT,A.SWAYDESCCN,A.SWAYDESC,A.SBIZSTATUS,B.* from TB_FLOW_PATH A INNER JOIN TB_FLOW_POST_DEFINE B ON A.SPOSTCODE_NEXT = B.SPOSTCODE WHERE A.SPOSTCODE_PRE = @SPOSTCODE_PRE ORDER BY A.NINDEX;</CommandSql>
      <NameValueParameters>
        <NameValueParameters>
          <VariableName>@SPOSTCODE_PRE</VariableName>
          <VariableType>varchar</VariableType>
          <VariableLength>40</VariableLength>
        </NameValueParameters>
