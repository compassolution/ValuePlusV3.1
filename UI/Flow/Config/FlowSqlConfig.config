  <!--对数据表【TB_FLOW_WORKFLOW_DETAIL】的根据流程实例ID获取该流程实例所有流转信息操作相关配置文件-->
  <TB_FLOW_WORKFLOW_DETAIL.selectAllByFlowId>
    <SqlBasicMetaData>
      <CommandType>text</CommandType>
      <CommandSql>SELECT * FROM TB_FLOW_WORKFLOW_DETAIL WHERE SWORKFLOWCODE =@SWORKFLOWCODE ORDER BY NNUMBER DESC</CommandSql>
      <NameValueParameters>
